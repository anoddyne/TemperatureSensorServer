<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="Vladimir">
        <createTable tableName="sensor">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
        <createTable tableName="measurement">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="value" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="is_raining" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="measurement_time" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="sensor_id" type="bigint">
                <constraints foreignKeyName="fk_measurement_sensor"
                referencedTableName="sensor"
                referencedColumnNames="id"
                             deleteCascade="true"
                />
            </column>
        </createTable>

    </changeSet>
</databaseChangeLog>